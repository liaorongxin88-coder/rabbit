<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Rabbit.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/rabbit_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rabbit.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/rabbit_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Rabbit.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/rabbit_text_primary</item>
    </style>

    <style name="TextAppearance.Rabbit.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/rabbit_text_secondary</item>
    </style>

    <style name="TextAppearance.Rabbit.Result" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/rabbit_danger</item>
    </style>

    <style name="Widget.Rabbit.Tag" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/rabbit_text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Widget.Rabbit.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/rabbit_radius_l</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/rabbit_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Rabbit.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/rabbit_radius_m</item>
        <item name="rippleColor">#22FFFFFF</item>
    </style>

    <style name="Widget.Rabbit.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/rabbit_radius_m</item>
        <item name="strokeColor">@color/rabbit_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Rabbit.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/rabbit_radius_m</item>
        <item name="rippleColor">#22FFFFFF</item>
    </style>

    <style name="Widget.Rabbit.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:textColor">@color/rabbit_text_primary</item>
        <item name="android:textColorHint">@color/rabbit_text_secondary</item>
    </style>

    <style name="Widget.Rabbit.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
