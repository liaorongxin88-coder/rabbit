<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/svBatchOps"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/topBar"
            layout="@layout/view_topbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/view_state_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/pbBatchOpsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBatchNextHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下一步：请选择母兔或育肥兔"
            android:padding="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvBatchSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="批次兔"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点选母兔：单选用于配种/摸胎/分娩等；多选用于批量催情"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadBatchRabbits"
                    style="@style/Widget.Rabbit.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="刷新批次兔列表"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="繁殖母兔"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <ListView
                    android:id="@+id/lvBreeding"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:choiceMode="multipleChoice" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAphStart"
                        style="@style/Widget.Rabbit.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开始催情" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAphFinish"
                        style="@style/Widget.Rabbit.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="完成催情"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="育肥商品兔（多选用于出售）"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <ListView
                    android:id="@+id/lvFattening"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:choiceMode="multipleChoice"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配种"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etMaleId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="公兔ID"
                        android:inputType="number" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickMale"
                        style="@style/Widget.Rabbit.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etMatingDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="配种日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMating"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提交配种"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="摸胎"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCheckDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="摸胎日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <Spinner
                    android:id="@+id/spCheckResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPregCheck"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提交摸胎"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="备产 / 放产箱"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPrepartumDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="备产日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrepartumFinish"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="备产完成"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="分娩"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="分娩日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etTotalKits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="总产仔数"
                    android:inputType="number"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etLiveKits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="活仔数"
                    android:inputType="number"
                    android:layout_marginTop="6dp" />

                <CheckBox
                    android:id="@+id/cbFailed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分娩失败（流产等）"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParturition"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提交分娩"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="断奶"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etWeaningDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="断奶日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etWeaningCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="断奶数量"
                    android:inputType="number"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etWeaningMaleCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="公兔数量（可选）"
                    android:inputType="number"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etWeaningFemaleCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="母兔数量（可选）"
                    android:inputType="number"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/etWeaningTargetCage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="目标笼位（默认自动）" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickWeaningTargetCage"
                        style="@style/Widget.Rabbit.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeaning"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提交断奶"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="出售"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSaleDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="出售日期 yyyy-MM-dd"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSale"
                    style="@style/Widget.Rabbit.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提交出售"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            app:cardUseCompatPadding="true"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="批次结束（手动）"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBatchEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="结束日期 yyyy-MM-dd（可选，默认今天）"
                    android:layout_marginTop="6dp" />

                <CheckBox
                    android:id="@+id/cbForceCompleteBatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="强制结束（退出所有活跃兔）"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCompleteBatch"
                    style="@style/Widget.Rabbit.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="结束批次"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvBatchOpsResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
