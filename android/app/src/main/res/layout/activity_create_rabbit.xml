<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rabbit_space_l">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="录入兔子"
                android:textAppearance="@style/TextAppearance.Rabbit.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rabbit_space_xs"
                android:text="快速录入基础信息，后续可以继续补充事件/称重/治疗"
                android:textAppearance="@style/TextAppearance.Rabbit.Caption" />

            <EditText
                android:id="@+id/etCageId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rabbit_space_l"
                android:hint="笼位ID"
                android:inputType="number" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickCage"
                style="@style/Widget.Rabbit.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择笼位"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <Spinner
                android:id="@+id/spRabbitType"
                style="@style/Widget.Rabbit.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rabbit_space_m" />

            <Spinner
                android:id="@+id/spRabbitGender"
                style="@style/Widget.Rabbit.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <EditText
                android:id="@+id/etBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="品种(可选)"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <Spinner
                android:id="@+id/spArrivalMethod"
                style="@style/Widget.Rabbit.Spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <EditText
                android:id="@+id/etArrivalDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="到场日期(yyyy-MM-dd，可选)"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="体重(kg，可选)"
                android:inputType="numberDecimal"
                android:layout_marginTop="@dimen/rabbit_space_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateRabbit"
                style="@style/Widget.Rabbit.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="提交"
                android:layout_marginTop="@dimen/rabbit_space_l" />

            <TextView
                android:id="@+id/tvCreateRabbitResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginTop="@dimen/rabbit_space_m"
                android:textAppearance="@style/TextAppearance.Rabbit.Result" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/pbCreateRabbitLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        layout="@layout/view_state_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rabbit_space_l"
        android:layout_marginEnd="@dimen/rabbit_space_l"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
