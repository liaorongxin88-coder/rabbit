<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Rabbit.Card"
    android:id="@+id/statePanel"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:visibility="gone"
    app:cardBackgroundColor="@color/rabbit_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/rabbit_space_l">

        <TextView
            android:id="@+id/tvStateEmoji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐇"
            android:textSize="40sp"
            android:gravity="center_horizontal" />

        <TextView
            android:id="@+id/tvStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rabbit_space_s"
            android:text="暂无数据"
            android:gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.Rabbit.Title" />

        <TextView
            android:id="@+id/tvStateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rabbit_space_xs"
            android:text=""
            android:gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.Rabbit.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStateAction"
            style="@style/Widget.Rabbit.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rabbit_space_m"
            android:text="刷新"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
