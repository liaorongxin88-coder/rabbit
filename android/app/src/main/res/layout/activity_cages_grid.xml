<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/boxCageSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/rabbit_space_l"
        android:paddingEnd="@dimen/rabbit_space_l"
        android:paddingTop="@dimen/rabbit_space_m"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvCageGridTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提示：点击格子进入笼位详情"
            android:textAppearance="@style/TextAppearance.Rabbit.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/rabbit_space_s">

            <EditText
                android:id="@+id/etCageSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="搜索笼位号：1-2-1"
                android:inputType="text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCageClear"
                style="@style/Widget.Rabbit.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:layout_marginStart="@dimen/rabbit_space_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCageRefresh"
                style="@style/Widget.Rabbit.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新"
                android:layout_marginStart="@dimen/rabbit_space_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCageManage"
                style="@style/Widget.Rabbit.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="维护"
                android:layout_marginStart="@dimen/rabbit_space_s" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowLayer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/rabbit_space_l"
        android:paddingEnd="@dimen/rabbit_space_l"
        android:paddingTop="@dimen/rabbit_space_s"
        android:paddingBottom="@dimen/rabbit_space_s"
        app:layout_constraintTop_toBottomOf="@id/boxCageSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="层：" />

        <Spinner
            android:id="@+id/spLayer"
            style="@style/Widget.Rabbit.Spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvCageLegend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="空=绿  有兔=蓝  已喂=更深"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbCageGridLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        layout="@layout/view_state_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rabbit_space_l"
        android:layout_marginEnd="@dimen/rabbit_space_l"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/rabbit_space_l"
        android:layout_marginEnd="@dimen/rabbit_space_l"
        android:layout_marginBottom="@dimen/rabbit_space_l"
        app:layout_constraintTop_toBottomOf="@id/rowLayer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <GridLayout
                android:id="@+id/gridCages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:useDefaultMargins="true" />
        </HorizontalScrollView>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
