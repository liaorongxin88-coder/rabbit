<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_topbar"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTopBack"
        style="@style/Widget.Rabbit.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="返回"
        android:textColor="?attr/colorOnPrimary"
        android:minWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTopRight"
        style="@style/Widget.Rabbit.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="操作"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        android:minWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvTopTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="标题"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnTopBack"
        app:layout_constraintEnd_toStartOf="@id/btnTopRight"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTopHouse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="?attr/colorOnPrimary"
        android:textSize="12sp"
        android:background="@drawable/bg_topbar_chip"
        app:layout_constraintStart_toStartOf="@id/tvTopTitle"
        app:layout_constraintEnd_toEndOf="@id/tvTopTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTopTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
