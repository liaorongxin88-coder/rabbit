<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/rabbit_space_l">

    <EditText
        android:id="@+id/etMemberUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="用户名" />

    <Spinner
        android:id="@+id/spMemberPerms"
        style="@style/Widget.Rabbit.Spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rabbit_space_m" />

    <CheckBox
        android:id="@+id/cbMemberAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="管理员"
        android:layout_marginTop="@dimen/rabbit_space_m" />

</LinearLayout>
