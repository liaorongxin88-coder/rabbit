# Copy this file to .env.deploy and fill in the server values.
# Do not commit .env.deploy if it contains private server details.

DEPLOY_HOST=rabbit.host.dzht.top
DEPLOY_PATH=/www/wwwroot/rabbit-admin

# The current deployment user is root. Override later if the server gets a
# dedicated deployment user.
DEPLOY_USER=root
DEPLOY_PORT=22

# Optional: SSH key for the deployment account.
# DEPLOY_SSH_KEY=/Users/you/.ssh/id_ed25519

# The admin static site is deployed on rabbit.host.dzht.top, while the backend
# API is served from api.dzht.top. This value is baked into the Vite build.
DEPLOY_API_BASE_URL=https://api.dzht.top
