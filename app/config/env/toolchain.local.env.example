# Optional local overrides used by ./rabbit and scripts/*.sh.
# Copy this file to toolchain.local.env and set only values that auto-detection
# cannot resolve on the current machine. Rabbit-specific environment variables
# override this file.

# RABBIT_FLUTTER_BIN=/path/to/flutter/bin/flutter
# RABBIT_FLUTTER_HOME=/path/to/flutter
# RABBIT_JAVA_HOME=/path/to/jdk-21/Contents/Home
# RABBIT_ANDROID_SDK_ROOT=/path/to/Android/sdk
