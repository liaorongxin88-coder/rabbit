<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rabbit.app.modules.admin.mapper.MerchantOverviewMapper">
    <resultMap id="RabbitHouseMap" type="com.rabbit.app.modules.house.entity.RabbitHouse">
        <id column="id" property="id"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="name" property="name"/>
        <result column="layout_rows" property="layoutRows"/>
        <result column="layout_cols" property="layoutCols"/>
        <result column="layout_layers" property="layoutLayers"/>
        <result column="request_id" property="requestId"/>
        <result column="remark" property="remark"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="AuditLogMap" type="com.rabbit.app.modules.audit.entity.AuditLog">
        <id column="id" property="id"/>
        <result column="trace_id" property="traceId"/>
        <result column="user_id" property="userId"/>
        <result column="house_id" property="houseId"/>
        <result column="method" property="method"/>
        <result column="path" property="path"/>
        <result column="query_string" property="queryString"/>
        <result column="status" property="status"/>
        <result column="api_code" property="apiCode"/>
        <result column="api_message" property="apiMessage"/>
        <result column="cost_ms" property="costMs"/>
        <result column="error_message" property="errorMessage"/>
        <result column="ip" property="ip"/>
        <result column="user_agent" property="userAgent"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="countHouses" resultType="long">
        select count(1)
        from rabbit_houses
        where merchant_id = #{merchantId} and is_deleted = false
    </select>

    <select id="countCages" resultType="long">
        select count(1)
        from cages c
        join rabbit_houses h on h.id = c.house_id
        where h.merchant_id = #{merchantId} and h.is_deleted = false
    </select>

    <select id="countRabbits" resultType="long">
        select count(1)
        from rabbits r
        join rabbit_houses h on h.id = r.house_id
        where h.merchant_id = #{merchantId} and h.is_deleted = false
    </select>

    <select id="selectHouses" resultMap="RabbitHouseMap">
        select id, merchant_id, name, layout_rows, layout_cols, layout_layers, request_id, remark, is_deleted, create_by, create_time, update_by, update_time
        from rabbit_houses
        where merchant_id = #{merchantId} and is_deleted = false
        order by id desc
        limit #{limit}
    </select>

    <select id="selectRecentAuditLogs" resultMap="AuditLogMap">
        select a.id, a.trace_id, a.user_id, a.house_id, a.method, a.path, a.query_string, a.status,
               a.api_code, a.api_message, a.cost_ms, a.error_message, a.ip, a.user_agent, a.create_time
        from audit_logs a
        join rabbit_houses h on h.id = a.house_id
        where h.merchant_id = #{merchantId}
        order by a.create_time desc, a.id desc
        limit #{limit}
    </select>
</mapper>
