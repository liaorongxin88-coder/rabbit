# Copy this file to .env for persistent local Docker Compose testing.
# Docker Compose loads the root .env automatically. Never commit real secrets.
# Replace every change-me value with an independently generated secret (for
# example, from `openssl rand -hex 32`). Keep stable secrets while reusing the
# same local database volume. The backend rejects these committed placeholders.

# Use 0.0.0.0 only when the backend must be reachable from the local network.
BACKEND_BIND_ADDRESS=127.0.0.1
# Add the exact LAN admin origin when opening Vite from another device, for
# example http://192.168.1.10:5173. Do not use a wildcard origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://admin.dzht.top
# Keep this at none unless the backend is reachable only through a trusted
# reverse proxy that overwrites client-supplied forwarding headers.
APP_FORWARD_HEADERS_STRATEGY=none

# How the app gets an OTA package.
# proxy (default): the device only talks to this backend, which relays the
#   upstream package. Use this when farm devices cannot reach GitHub. It
#   requires that this backend host can itself reach the upstream URL.
# direct: hand the device the URL recorded in the release catalog. Cheaper
#   here, but the device must be able to reach it.
APP_UPDATE_DOWNLOAD_MODE=proxy
# Public HTTPS address of this backend, used to build the proxied download URL.
# Keep it aligned with the app's RABBIT_API_BASE_URL. In proxy mode the backend
# refuses to start when this is missing or is not HTTPS.
APP_UPDATE_PUBLIC_BASE_URL=https://api.dzht.top

# Password image captcha and SMS verification require Redis or Valkey because
# their short-lived security state is stored there atomically. The local default
# starts Redis through Compose; use valkey instead only when needed.
COMPOSE_PROFILES=redis
CACHE_REDIS_BIND_ADDRESS=127.0.0.1
CACHE_REDIS_HOST_PORT=16380
CACHE_VALKEY_BIND_ADDRESS=127.0.0.1
CACHE_VALKEY_HOST_PORT=16381
APP_CACHE_PROVIDER=redis
APP_CACHE_HOST=redis
APP_CACHE_PORT=6379
APP_CACHE_USERNAME=
APP_CACHE_PASSWORD=
APP_CACHE_DATABASE=0
APP_CACHE_SSL_ENABLED=false
APP_CACHE_CONNECT_TIMEOUT=2s
APP_CACHE_COMMAND_TIMEOUT=1s
APP_CACHE_KEY_PREFIX=rabbit:cache:v1

APP_JWT_SECRET=change-me-to-a-random-app-jwt-secret
APP_ADMIN_JWT_SECRET=change-me-to-a-different-random-admin-jwt-secret
APP_PHONE_HASH_SECRET=change-me-to-a-stable-phone-hash-secret

# Keep SMS disabled until Redis/Valkey, all Aliyun credentials, sign, and
# template values are configured. The RAM identity only needs dysms:SendSms.
APP_SMS_ENABLED=false
APP_SMS_CODE_SECRET=change-me-to-a-stable-sms-code-secret

# Password login always requires a short-lived image captcha. Keep it enabled
# outside explicit emergency maintenance windows and use a separate secret.
APP_CAPTCHA_ENABLED=true
APP_CAPTCHA_CODE_SECRET=change-me-to-a-stable-captcha-code-secret
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
APP_SMS_SIGN_NAME=
APP_SMS_TEMPLATE_CODE=

# These defaults match a template variable named ${code} on Aliyun China SMS.
APP_SMS_TEMPLATE_PARAM_NAME=code
APP_SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# Carrier one-tap login is a separate service and uses a separate least-
# privilege RAM identity with dypns:GetMobile. Keep it disabled until the
# Aliyun Android scheme/AAR and the backend credentials are both configured.
APP_PHONE_ONE_TAP_ENABLED=false
APP_PHONE_ONE_TAP_ALLOWED_PROVIDERS=aliyun
APP_PHONE_ONE_TAP_TOKEN_HASH_SECRET=change-me-to-a-stable-one-tap-token-hash-secret
APP_PHONE_ONE_TAP_IP_MINUTE_LIMIT=10
APP_PHONE_ONE_TAP_IP_HOUR_LIMIT=60
APP_PHONE_ONE_TAP_CONNECT_TIMEOUT_MS=2000
APP_PHONE_ONE_TAP_READ_TIMEOUT_MS=3000
APP_PHONE_ONE_TAP_SUCCESS_RETRY_WINDOW_SECONDS=30
# Must be strictly greater than connect timeout + read timeout + 1000 ms.
APP_PHONE_ONE_TAP_PROCESSING_LEASE_SECONDS=15
APP_PHONE_ONE_TAP_ATTEMPT_RETENTION_DAYS=7
APP_PHONE_ONE_TAP_RATE_BUCKET_RETENTION_HOURS=2
APP_PHONE_ONE_TAP_CLEANUP_CRON="0 35 3 * * ?"
APP_PHONE_ONE_TAP_ALIYUN_ENDPOINT=dypnsapi.aliyuncs.com
APP_PHONE_ONE_TAP_ALIYUN_ACCESS_KEY_ID=
APP_PHONE_ONE_TAP_ALIYUN_ACCESS_KEY_SECRET=

# Required by docker-compose.yml. This value is only for local testing.
APP_NFC_TAG_ACTIVE_KEY_ID=1
APP_NFC_TAG_SIGNING_KEYS=1=cmFiYml0LW5mYy1kZXYtc2lnbmluZy1rZXktY2hhbmdlLW1l
